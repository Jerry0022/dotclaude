{
  "description": "devops lifecycle hooks — guards, triggers, and automation across the full session lifecycle",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/dispatch.js\" SessionStart", "timeout": 25 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/dispatch.js\" PreToolUse", "timeout": 65 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/dispatch.js\" SubagentStop", "timeout": 35 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/dispatch.js\" SubagentStart", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/dispatch.js\" PostToolUse", "timeout": 65 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/dispatch.js\" PostToolUseFailure", "timeout": 65 }
        ],
        "matcher": "mcp__ccd_session_mgmt__archive_session|Bash|PowerShell"
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/dispatch.js\" Stop", "timeout": 65 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch/dispatch.js\" UserPromptSubmit", "timeout": 65 }
        ]
      }
    ]
  }
}
